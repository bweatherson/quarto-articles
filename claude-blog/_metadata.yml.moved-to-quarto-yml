# Options for all posts in claude-blog/. Copied from posts/_metadata.yml so that
# these render the same way as the main papers. Nothing here is linked from any
# public page; the folder is in-house until decided otherwise.

freeze: true
title-block-banner: true

bibliography: ../../brian-quarto.bib
csl: ../../chicago-with-note.csl

format:
    docx:
      reference-doc: ../../quarto-articles-template.docx
      toc: false
      number-sections: true
    html:
      toc: true
      toc-depth: 3
      fontsize: 1.25em
      toc-location: left
      toc-title: "Sections"
      reference-location: margin
      appendix-cite-as: bibtex
      pagetitle: "{{< meta title >}}"
    pdf:
      classoption: twoside
      geometry: "left=1.1in,
                 right=1in,
                 top=0.8in,
                 bottom=0.8in,
                 paperheight=9.5in,
                 paperwidth=7in,
                 includemp=TRUE,
                 marginparwidth=0in,
                 marginparsep=0in"
      mathspec: false
      mathfont: Garamond-Math
      fontsize: 11pt
      indent: true
      linkcolor: black
      urlcolor: black
      colorlinks: false
      linestretch: 1.1
      link-citations: true
      keep-tex: true
      pdf-engine: xelatex
      include-in-header:
        file: quarto2024.tex
      date-format: "YYYY"
number-sections: true
number-depth: 3
