%% ---------------------------------------------------------------------------
%% Type "article" — a journal article. Give volume, number, month and pages.
%% ---------------------------------------------------------------------------
@article{haugerud2001,
  author       = {Haugerud, Ingvild},
  title        = {Self-Location and the {Vigil}},
  journaltitle = {Inquiries in Formal Epistemology},
  volume       = {12},
  number       = {1},
  pages        = {33--41},
  year         = {2001},
  month        = {3},
  doi          = {10.00000/ife.2001.12.33},
}

%% Journals that number articles rather than paginate them: use `eid' in place of
%% `pages'.
@article{renner-alvi2023,
  author       = {Renner-Alvi, Dorothea},
  title        = {Non-Ideal Agents and the Demands of Coherence},
  journaltitle = {Ratio Formalis},
  volume       = {58},
  number       = {3},
  eid          = {214},
  year         = {2023},
  month        = {8},
  doi          = {10.00000/rf.2023.58.214},
}

%% Accepted but not yet issued: `pubstate = {forthcoming}' replaces the year in the
%% citation. Add the DOI as soon as the publisher registers one. Update the entry
%% before you return your proofs.
@article{abiodun2026,
  author       = {Abiodun, Kelechi},
  title        = {Vigils, Duplicates, and the Value of Evidence},
  journaltitle = {Inquiries in Formal Epistemology},
  pubstate     = {forthcoming},
  doi          = {10.00000/ife.2026.0092},
}

%% A preprint that has not appeared anywhere else. Use the `url` field if no DOI
%% exists.
@unpublished{tanaka2025,
  author       = {Tanaka, Miho},
  title        = {A Topology for Self-Locating Credence},
  note         = {preprint, arXiv},
  date         = {2025-03-03},
  doi          = {10.00000/arXiv.2503.01947},
}


